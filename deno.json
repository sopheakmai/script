{
  "tasks": {
    "dev": "deno run --allow-read --allow-write index.ts",
    "scan": "deno run --allow-read --allow-write scripts/scan.ts",
    "rename": "deno run --allow-read --allow-write scripts/rename-file.ts",
    "build": "deno compile --allow-read --allow-write -o app index.ts",
    "build:scan": "deno compile --allow-read --allow-write -o scan scripts/scan.ts",
    "build:rename": "deno compile --allow-read --allow-write -o rename scripts/rename-file.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "picocolors": "npm:picocolors@^1.1.1"
  }
}
